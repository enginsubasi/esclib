# what: One bit of the polynomial is wrong, which still produces a plausible looking number and agrees with nothing.
#
# Applied by scripts/mutate.sh, which requires the FIND block to match
# exactly once and the named test to fail because of it.
FILE src/crc/crc32.c
TEST CRC_Test
--- FIND
uint32_t crc32Alt ( const uint8_t* const array, uint32_t size )
{
    uint32_t i = 0;         // Array index counter.
    uint8_t j = 0;          // Bit shift counter.

    uint32_t crc = 0xffffffff;

    /* Loop until size. */
    for ( i = 0; i < size; ++i )
    {
        crc = crc ^ ( ( ( uint32_t ) array[ i ] ) << 24 );

        for ( j = 0 ; j < 8 ; ++j )
        {
            if ( crc & 0x80000000u )
            {
                crc = ( crc << 1 ) ^ 0x04C11DB7u;
            }
            else
            {
                crc = ( crc << 1 );
            }
        }
    }

    return ( crc );
}
--- REPLACE
uint32_t crc32Alt ( const uint8_t* const array, uint32_t size )
{
    uint32_t i = 0;         // Array index counter.
    uint8_t j = 0;          // Bit shift counter.

    uint32_t crc = 0xffffffff;

    /* Loop until size. */
    for ( i = 0; i < size; ++i )
    {
        crc = crc ^ ( ( ( uint32_t ) array[ i ] ) << 24 );

        for ( j = 0 ; j < 8 ; ++j )
        {
            if ( crc & 0x80000000u )
            {
                crc = ( crc << 1 ) ^ 0x04C11DB6u;
            }
            else
            {
                crc = ( crc << 1 );
            }
        }
    }

    return ( crc );
}
--- END
