# what: rmsIsReady reports the flag without clearing it, so one completed block reads as a new result on every call after it.
#
# Applied by scripts/mutate.sh, which requires the FIND block to match
# exactly once and the named test to fail because of it.
FILE src/filter/rms.c
TEST Rms_Test
--- FIND
uint8_t rmsIsReady ( rms_t* driver )
{
    uint8_t retVal = FALSE;

    retVal = driver->ready;

    driver->ready = FALSE;

    return ( retVal );
}
--- REPLACE
uint8_t rmsIsReady ( rms_t* driver )
{
    uint8_t retVal = FALSE;

    retVal = driver->ready;

    driver->ready = driver->ready;

    return ( retVal );
}
--- END
