# what: mathFindMini32 compares the wrong way round and returns the largest element.
#
# Applied by scripts/mutate.sh, which requires the FIND block to match
# exactly once and the named test to fail because of it.
FILE src/math/basicmath.c
TEST Math_Test
--- FIND
int32_t mathFindMini32 ( const int32_t* const array, uint32_t length )
{
    uint32_t i = 0;
    int32_t tempMin = 0;

    if ( length != 0 )
    {
        tempMin = array[ 0 ];

        for ( i = 1; i < length; ++i )
        {
            if ( tempMin > array[ i ] )
            {
                tempMin = array[ i ];
            }
        }
    }
    else
    {
        /* Intentionally blank. */
    }

    return ( tempMin );
}
--- REPLACE
int32_t mathFindMini32 ( const int32_t* const array, uint32_t length )
{
    uint32_t i = 0;
    int32_t tempMin = 0;

    if ( length != 0 )
    {
        tempMin = array[ 0 ];

        for ( i = 1; i < length; ++i )
        {
            if ( tempMin < array[ i ] )
            {
                tempMin = array[ i ];
            }
        }
    }
    else
    {
        /* Intentionally blank. */
    }

    return ( tempMin );
}
--- END
