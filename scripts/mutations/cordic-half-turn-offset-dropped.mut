# what: A vector in the left half plane is folded over to reach the quadrant the iteration converges in, and the half turn that folding costs is not put back, so every angle past a quarter turn is reported as its opposite.
#
# Applied by scripts/mutate.sh, which requires the FIND block to match
# exactly once and the named test to fail because of it.
FILE src/math/cordic.c
TEST Cordic_Test
--- FIND
void cordicPolar ( int32_t x, int32_t y, int32_t* magnitude, uint32_t* angle )
{
    int32_t xi = x;
    int32_t yi = y;
    int32_t residual = 0;
    int64_t length = 0;
    uint32_t left = 0u;
    uint32_t right = 0u;
    uint32_t offset = 0u;

    if ( ( x == 0 ) && ( y == 0 ) )
    {
        *magnitude = 0;
        *angle = 0u;
    }
    else
    {
        cordicNormalize ( &xi, &yi, &left, &right );

        if ( xi < 0 )
        {
            xi = -xi;
            yi = -yi;
            offset = CORDIC_HALF;
        }
        else
        {
            /* Intentionally blank */
        }

        cordicVectoring ( &xi, yi, &residual );

        length = ( ( ( int64_t ) xi ) * CORDIC_INVGAIN_Q24 ) +
                 CORDIC_INVGAIN_HALF;
        length = length >> CORDIC_INVGAIN_SHIFT;

        *magnitude = cordicDenormalize ( length, left, right );
        *angle = ( ( uint32_t ) residual ) + offset;
    }
}
--- REPLACE
void cordicPolar ( int32_t x, int32_t y, int32_t* magnitude, uint32_t* angle )
{
    int32_t xi = x;
    int32_t yi = y;
    int32_t residual = 0;
    int64_t length = 0;
    uint32_t left = 0u;
    uint32_t right = 0u;
    uint32_t offset = 0u;

    if ( ( x == 0 ) && ( y == 0 ) )
    {
        *magnitude = 0;
        *angle = 0u;
    }
    else
    {
        cordicNormalize ( &xi, &yi, &left, &right );

        if ( xi < 0 )
        {
            xi = -xi;
            yi = -yi;
            offset = 0u;
        }
        else
        {
            /* Intentionally blank */
        }

        cordicVectoring ( &xi, yi, &residual );

        length = ( ( ( int64_t ) xi ) * CORDIC_INVGAIN_Q24 ) +
                 CORDIC_INVGAIN_HALF;
        length = length >> CORDIC_INVGAIN_SHIFT;

        *magnitude = cordicDenormalize ( length, left, right );
        *angle = ( ( uint32_t ) residual ) + offset;
    }
}
--- END
