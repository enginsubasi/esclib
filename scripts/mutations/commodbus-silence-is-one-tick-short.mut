# what: The frame ends one tick early. Three and a half character times is the boundary the specification draws, and a device that ends a frame before it eats the first byte of the next one.
#
# Applied by scripts/mutate.sh, which requires the FIND block to match
# exactly once and the named test to fail because of it.
FILE src/communication/commodbus.c
TEST ComModbus_Test
--- FIND
void commodbusTimeoutCounter ( commodbus_t* driver )
{
    if ( ( driver->rxReadyToEvaluate == FALSE ) && ( driver->rxIndex > 0u ) )
    {
        if ( driver->silenceCounter >= driver->silenceTicks )
        {
            driver->rxReadyToEvaluate = TRUE;
        }
        else
        {
            ++driver->silenceCounter;
        }
    }
    else
    {
        /* Intentionally blank */
    }
}
--- REPLACE
void commodbusTimeoutCounter ( commodbus_t* driver )
{
    if ( ( driver->rxReadyToEvaluate == FALSE ) && ( driver->rxIndex > 0u ) )
    {
        if ( ( driver->silenceCounter + 1u ) >= driver->silenceTicks )
        {
            driver->rxReadyToEvaluate = TRUE;
        }
        else
        {
            ++driver->silenceCounter;
        }
    }
    else
    {
        /* Intentionally blank */
    }
}
--- END
