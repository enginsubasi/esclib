# what: cobsDecode steps over a run without checking it for zeros, so a frame the encoder would never write is accepted.
#
# The same defect as cobs-decode-accepts-a-zero-inside-a-run.mut, held
# against the fuzz harness, whose re-encoding check is what catches it there.
#
# Applied by scripts/mutate.sh, which requires the FIND block to match
# exactly once and the named test to fail because of it.
FILE src/communication/cobs.c
TEST Fuzz_Test
--- FIND
            /* A zero here is a delimiter inside the frame. */
            for ( i = 0u; i < ( code - 1u ); ++i )
            {
                if ( source[ read + i ] == COBS_DELIMITER )
                {
                    sound = FALSE;
                }
                else
                {
                    /* Intentionally blank */
                }
            }
--- REPLACE
            /* mutant: the run is stepped over without looking inside it */
--- END
