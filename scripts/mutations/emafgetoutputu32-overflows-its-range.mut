# what: emafGetOutputu32 casts an accumulator above 2^32 straight to uint32_t, which wraps instead of saturating.
#
# Applied by scripts/mutate.sh, which requires the FIND block to match
# exactly once and the named test to fail because of it.
FILE src/filter/emaf.c
TEST Filter_Test
--- FIND
uint32_t emafGetOutputu32 ( const emafu32_t* const driver )
{
    uint32_t retVal = 0;

    // 4294967296.0f is exactly 2^32 and is representable, unlike 0xFFFFFFFF.
    if ( driver->accumulator >= 4294967296.0f )
    {
        retVal = 0xFFFFFFFFu;
    }
    else
    {
        retVal = ( uint32_t ) driver->accumulator;
    }

    return ( retVal );
}
--- REPLACE
uint32_t emafGetOutputu32 ( const emafu32_t* const driver )
{
    uint32_t retVal = 0;

    retVal = ( uint32_t ) driver->accumulator;

    return ( retVal );
}
--- END
