# what: The byte enters at the low end instead of the high one, which is the standard confusion between an MSB first and an LSB first CRC and makes the streaming form disagree with the table.
#
# Applied by scripts/mutate.sh, which requires the FIND block to match
# exactly once and the named test to fail because of it.
FILE src/crc/crc32.c
TEST CRC_Test
--- FIND
uint32_t crc32AltUpdate ( uint32_t crc, uint8_t data )
{
    uint32_t retVal = 0;
    uint8_t j = 0;

    retVal = crc ^ ( ( ( uint32_t ) data ) << 24 );

    for ( j = 0; j < 8; ++j )
    {
        if ( ( retVal & 0x80000000u ) != 0u )
        {
            retVal = ( retVal << 1 ) ^ 0x04C11DB7u;
        }
        else
        {
            retVal = retVal << 1;
        }
    }

    return ( retVal );
}
--- REPLACE
uint32_t crc32AltUpdate ( uint32_t crc, uint8_t data )
{
    uint32_t retVal = 0;
    uint8_t j = 0;

    retVal = crc ^ ( ( uint32_t ) data );

    for ( j = 0; j < 8; ++j )
    {
        if ( ( retVal & 0x80000000u ) != 0u )
        {
            retVal = ( retVal << 1 ) ^ 0x04C11DB7u;
        }
        else
        {
            retVal = retVal << 1;
        }
    }

    return ( retVal );
}
--- END
