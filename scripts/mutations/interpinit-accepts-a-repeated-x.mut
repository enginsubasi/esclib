# what: interpInit accepts a table with two equal x entries, which reaches the divide: the i32 path divides by zero and the float path hands back an inf.
#
# Applied by scripts/mutate.sh, which requires the FIND block to match
# exactly once and the named test to fail because of it.
FILE src/math/interp.c
TEST Interp_Test
--- FIND
uint8_t interpInit ( interp_t* driver, const float* const xTable, const float* const yTable, uint32_t length )
{
    uint8_t retVal = FALSE;
    uint8_t ascending = TRUE;
    uint32_t i = 0;

    if ( ( driver != NULL ) && ( xTable != NULL ) && ( yTable != NULL ) &&
         ( length >= INTERP_MIN_LENGTH ) )
    {
        for ( i = 1u; i < length; ++i )
        {
            if ( xTable[ i ] <= xTable[ i - 1u ] )
            {
                ascending = FALSE;
            }
            else
            {
                /* Intentionally blank */
            }
        }

        if ( ascending == TRUE )
        {
            driver->xTable = xTable;
            driver->yTable = yTable;
            driver->length = length;

            retVal = TRUE;
        }
        else
        {
            retVal = FALSE;
        }
    }
    else
    {
        retVal = FALSE;
    }

    return ( retVal );
}
--- REPLACE
