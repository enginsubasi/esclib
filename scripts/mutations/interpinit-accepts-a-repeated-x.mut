    if ( ( driver != NULL ) && ( xTable != NULL ) && ( yTable != NULL ) &&
         ( length >= INTERP_MIN_LENGTH ) )
    {
        for ( i = 1u; i < length; ++i )
        {
            if ( xTable[ i ] < xTable[ i - 1u ] )
            {
                ascending = FALSE;
            }
            else
            {
                /* Intentionally blank */
            }
        }

        if ( ascending == TRUE )
        {
            driver->xTable = xTable;
            driver->yTable = yTable;
            driver->length = length;

            retVal = TRUE;
        }
        else
        {
            retVal = FALSE;
        }
    }
    else
    {
        retVal = FALSE;
    }

    return ( retVal );
}
--- END
