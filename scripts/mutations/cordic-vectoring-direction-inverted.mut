# what: The vectoring mode drives the second component away from zero instead of towards it, so the accumulated angle is the negative of the one the vector actually has.
#
# Applied by scripts/mutate.sh, which requires the FIND block to match
# exactly once and the named test to fail because of it.
FILE src/math/cordic.c
TEST Cordic_Test
--- FIND
static void cordicVectoring ( int32_t* x, int32_t y, int32_t* angle )
{
    uint32_t i = 0u;
    int32_t xi = *x;
    int32_t yi = y;
    int32_t zi = 0;
    int32_t xn = 0;

    for ( i = 0u; i < CORDIC_ITERATIONS; ++i )
    {
        xn = xi;

        if ( yi < 0 )
        {
            xi = xi - ( yi >> i );
            yi = yi + ( xn >> i );
            zi = zi - cordicAtanTable[ i ];
        }
        else
        {
            xi = xi + ( yi >> i );
            yi = yi - ( xn >> i );
            zi = zi + cordicAtanTable[ i ];
        }
    }

    *x = xi;
    *angle = zi;
}
--- REPLACE
static void cordicVectoring ( int32_t* x, int32_t y, int32_t* angle )
{
    uint32_t i = 0u;
    int32_t xi = *x;
    int32_t yi = y;
    int32_t zi = 0;
    int32_t xn = 0;

    for ( i = 0u; i < CORDIC_ITERATIONS; ++i )
    {
        xn = xi;

        if ( yi > 0 )
        {
            xi = xi - ( yi >> i );
            yi = yi + ( xn >> i );
            zi = zi - cordicAtanTable[ i ];
        }
        else
        {
            xi = xi + ( yi >> i );
            yi = yi - ( xn >> i );
            zi = zi + cordicAtanTable[ i ];
        }
    }

    *x = xi;
    *angle = zi;
}
--- END
