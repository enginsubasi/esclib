# what: Each byte is written low nibble first, so 0x1F comes out as F1. Every byte whose two nibbles differ is wrong and every one whose nibbles match is right, which is why a test on 0x00 and 0xFF alone would pass it.
#
# Applied by scripts/mutate.sh, which requires the FIND block to match
# exactly once and the named test to fail because of it.
FILE src/text/text.c
TEST Text_Test
--- FIND
uint8_t textHexEncode ( const uint8_t* const source, uint32_t length,
                        uint8_t* destination, uint32_t capacity,
                        uint32_t* written )
{
    uint8_t retVal = FALSE;
    uint32_t i = 0u;

    if ( length <= ( capacity / 2u ) )
    {
        for ( i = 0u; i < length; ++i )
        {
            destination[ 2u * i ] =
                textHexDigit ( ( ( uint32_t ) source[ i ] >> 4 ) & 0x0Fu );
            destination[ ( 2u * i ) + 1u ] =
                textHexDigit ( ( uint32_t ) source[ i ] & 0x0Fu );
        }

        *written = 2u * length;

        retVal = TRUE;
    }
    else
    {
        /* Intentionally blank */
    }

    return ( retVal );
}
--- REPLACE
uint8_t textHexEncode ( const uint8_t* const source, uint32_t length,
                        uint8_t* destination, uint32_t capacity,
                        uint32_t* written )
{
    uint8_t retVal = FALSE;
    uint32_t i = 0u;

    if ( length <= ( capacity / 2u ) )
    {
        for ( i = 0u; i < length; ++i )
        {
            destination[ 2u * i ] =
                textHexDigit ( ( uint32_t ) source[ i ] & 0x0Fu );
            destination[ ( 2u * i ) + 1u ] =
                textHexDigit ( ( ( uint32_t ) source[ i ] >> 4 ) & 0x0Fu );
        }

        *written = 2u * length;

        retVal = TRUE;
    }
    else
    {
        /* Intentionally blank */
    }

    return ( retVal );
}
--- END
